APP_ENV=development
# Generate with: python scripts/generate_key.py
APP_SECRET_KEY=
TELEGRAM_BOT_TOKEN=
ALLOWED_TELEGRAM_USER_IDS=
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_PRIMARY_MODEL=gemini-3.5-flash-lite
# Blank uses the primary model for simple tasks and receipt images.
GEMINI_FAST_MODEL=
# Pace Gemini calls for its free tier; check your active limit in AI Studio.
GEMINI_REQUESTS_PER_MINUTE=8
# Optional paid OpenAI alternative: set AI_PROVIDER=openai and fill the key below.
OPENAI_API_KEY=
OPENAI_PRIMARY_MODEL=gpt-6-astra
# Blank falls back to primary; choose a model supporting structured outputs AND images.
OPENAI_FAST_MODEL=
DATABASE_URL=postgresql+asyncpg://ponke:change-this-password@db:5432/ponke
POSTGRES_PASSWORD=change-this-password
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/oauth/google/callback
GOOGLE_CALENDAR_ID=primary
# Change this if another local app uses port 8000; match GOOGLE_REDIRECT_URI.
PONKE_HOST_PORT=8000
USER_TIMEZONE=Asia/Jakarta
DEFAULT_CURRENCY=IDR
DAILY_BRIEFING_ENABLED=true
DAILY_BRIEFING_TIME=07:00
DAILY_BRIEFING_SECTIONS=today,reminders,finance,notable,priorities
MAX_UPLOAD_BYTES=10000000
REQUESTS_PER_MINUTE=12
LARGE_TRANSACTION_THRESHOLD=10000000
MODEL_TIMEOUT_SECONDS=90
# Optional USD per million tokens. Blank means cost unavailable, never zero.
PRIMARY_INPUT_COST_PER_MILLION=
PRIMARY_OUTPUT_COST_PER_MILLION=
FAST_INPUT_COST_PER_MILLION=
FAST_OUTPUT_COST_PER_MILLION=
